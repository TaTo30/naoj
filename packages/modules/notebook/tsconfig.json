{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*", "manifest.json"],
  "compilerOptions": {
    "composite": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
